<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Required on Android 11+ (API 30+) to be able to see the other browsers
        that can open a web URL. Without it queryIntentActivities() only ever
        returns our own package.

        Do NOT add <category> elements here. The queries entry is matched
        against the filters of every installed app; listing a category makes
        the visibility filter stricter, and a stricter filter can end up
        excluding the very browsers we are looking for (symptom: the picker
        reports "no other browser found" on devices that clearly have some).
        The action + scheme combination alone matches every app that can open
        a web link, which is exactly what we want.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrowserPicker"
        tools:targetApi="34">

        <!--
            BrowserInterceptorActivity serves double duty:

            1. When opened via a URL intent (ACTION_VIEW on http/https):
               Acts as a transparent jump page. The transparent theme gives the
               appearance of a system dialog overlaid on the calling app. The
               user picks a browser and the URL is forwarded.

            2. When opened from the launcher (ACTION_MAIN):
               Shows the list of installed browsers plus a shortcut to the
               system screen where this app can become the default browser.

            Launch mode: singleTask ensures a single instance. When the activity
            is already alive and a new URL comes in, onNewIntent() is called
            instead of onCreate(), and the pending URL is published through a
            StateFlow so the dialog can simply be recomposed.

            excludeFromRecents is NOT set here because we need the launcher
            activity to appear in recents. We handle "no leftover task" by
            finishing the activity immediately after forwarding the URL, and
            the transparent theme prevents visual intrusion.
        -->
        <activity
            android:name=".BrowserInterceptorActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.BrowserPicker.Transparent">

            <!-- Launcher entry: lets the user open the app to pick a browser
                 and to set the app as the system default browser. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Browser registration: these intent filters make Android
                 recognize this app as a browser capable of handling web URLs.
                 android:autoVerify="false" because we do NOT want to claim
                 ownership of any links. -->
            <intent-filter
                android:autoVerify="false"
                android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
            </intent-filter>

            <intent-filter
                android:autoVerify="false"
                android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

    </application>
</manifest>